# Copy to .env for local development. On Vercel, set these in
# Project Settings > Environment Variables. Everything is optional: the site
# builds and runs without any of them (forms log to the console in dev).

# Public URL, used for canonical links, sitemap, OG images and JSON-LD.
PUBLIC_SITE_URL=https://fundacionverde.org

# English site: keep "false" until the translation is reviewed. While false the
# EN toggle shows a notice, /en pages are noindex and left out of the sitemap.
PUBLIC_ENGLISH_ENABLED=false

# --- Forms -----------------------------------------------------------------
# GoHighLevel inbound webhook. One URL for all forms (payload has form_type),
# or override per form with the *_REGISTRATION / _VOLUNTEER / _CONTACT /
# _NEWSLETTER variants. Called from the server (/api/submit), never the browser.
PUBLIC_GHL_WEBHOOK_URL=
PUBLIC_GHL_WEBHOOK_URL_REGISTRATION=
PUBLIC_GHL_WEBHOOK_URL_VOLUNTEER=
PUBLIC_GHL_WEBHOOK_URL_CONTACT=
PUBLIC_GHL_WEBHOOK_URL_NEWSLETTER=

# Fallback when GHL is not configured (or fails): email the submission via Resend.
RESEND_API_KEY=
RESEND_FROM="Fundación Verde <sitio@fundacionverde.org>"
CONTACT_TO=hola@fundacionverde.org

# --- Registration counts (capacity bars) -------------------------------------
# Vercel KV / Upstash Redis REST credentials. Without them the capacity bars
# stay hidden (registrations still go to GHL or email).
KV_REST_API_URL=
KV_REST_API_TOKEN=
# or: UPSTASH_REDIS_REST_URL= / UPSTASH_REDIS_REST_TOKEN=

# --- Donations (Stripe Checkout) --------------------------------------------
# While PUBLIC_STRIPE_PUBLISHABLE_KEY is empty, the donate button shows the
# prototype's "payment gateway coming soon" notice instead of opening Checkout.
STRIPE_SECRET_KEY=
PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Analytics (pick one) -----------------------------------------------------
PUBLIC_PLAUSIBLE_DOMAIN=
# PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js
PUBLIC_GA4_ID=

# --- Build ------------------------------------------------------------------
# Node runtime for the serverless functions (see scripts/vercel-runtime.mjs).
# VERCEL_NODE_RUNTIME=nodejs22.x
