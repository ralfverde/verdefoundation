---
import Icon from '../components/Icon.astro';
import Pill from '../components/Pill.astro';
import Layout from '../layouts/Layout.astro';
import { dict, href, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = dict(lang);
const g = t.gracias;
---
<Layout lang={lang} title={t.pageTitles.gracias} description={t.pageDescriptions.gracias} ogKey="donar" noindex>
  <div class="container page-hero">
    <Pill>{g.pill}</Pill>
    <h1 class="h1">{g.title}</h1>
    <p class="lead">{g.lead}</p>
    <p class="muted" style="margin-top:1rem;max-width:38rem">{g.monthlyNote}</p>
    <div class="hero__cta">
      <a class="btn btn--primary btn--lg" href={href(lang, '/eventos')}><Icon name="calendar" />{g.ctaEvents}</a>
      <a class="btn btn--ghost btn--lg" href={href(lang, '/')}>{g.ctaHome}</a>
    </div>
  </div>
</Layout>
