---
import { SITE, ENGLISH_ENABLED } from '../lib/site';
import { basePath, dict, fmt, href, type Lang } from '../lib/i18n';
import { inlineJson } from '../lib/json';

interface Props {
  lang: Lang;
  /** Page name ("Programas"); omit on the home page */
  title?: string;
  description?: string;
  /** Path of the generated OG image, e.g. "/og/es/programas.png" */
  ogImage: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
}

const { lang, title, description, ogImage, noindex = false, jsonLd = [] } = Astro.props;
const t = dict(lang);
const fullTitle = title ? fmt(t.meta.titleTemplate, { page: title }) : t.meta.homeTitle;
const desc = description ?? t.meta.description;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = `${SITE.url}${path === '/' ? '' : path}` || SITE.url;
const base = basePath(Astro.url.pathname);
// English pages stay out of search results until the translation is reviewed.
const robots = noindex || (lang === 'en' && !ENGLISH_ENABLED) ? 'noindex, follow' : null;

const organization = {
  '@context': 'https://schema.org',
  '@type': 'NGO',
  '@id': `${SITE.url}/#organization`,
  name: SITE.name,
  url: SITE.url,
  logo: `${SITE.url}/logo.png`,
  description: t.meta.orgDescription,
  email: SITE.email,
  areaServed: { '@type': 'State', name: 'Florida' },
  address: { '@type': 'PostalAddress', addressLocality: 'Miami', addressRegion: 'FL', addressCountry: 'US' },
  sameAs: [SITE.instagramUrl, SITE.facebookUrl],
  ...(SITE.ein ? { taxID: SITE.ein } : {}),
};
---
<title>{fullTitle}</title>
<meta name="description" content={desc} />
<link rel="canonical" href={canonical} />
{robots && <meta name="robots" content={robots} />}
{
  ENGLISH_ENABLED && (
    <>
      <link rel="alternate" hreflang="es" href={`${SITE.url}${href('es', base) === '/' ? '' : href('es', base)}`} />
      <link rel="alternate" hreflang="en" href={`${SITE.url}${href('en', base)}`} />
      <link rel="alternate" hreflang="x-default" href={`${SITE.url}${href('es', base) === '/' ? '' : href('es', base)}`} />
    </>
  )
}
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={title ? fmt(t.meta.titleTemplate, { page: title }) : SITE.name} />
<meta property="og:description" content={title ? desc : t.meta.ogDescription} />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={t.meta.ogLocale} />
<meta property="og:image" content={`${SITE.url}${ogImage}`} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<script type="application/ld+json" set:html={inlineJson(organization)} />
{jsonLd.map((data) => <script type="application/ld+json" set:html={inlineJson({ '@context': 'https://schema.org', ...data })} />)}
