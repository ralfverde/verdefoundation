---
/** Stylized Florida silhouette with a marker per venue region, fed by the events collection. */
import type { RegionSummary } from '../lib/where';

interface Props {
  regions: RegionSummary[];
  label: string;
}
const { regions, label } = Astro.props;
---
<div class="where__map" role="img" aria-label={label}>
  <svg viewBox="0 0 250 262" aria-hidden="true">
    <path
      class="fl-shape"
      d="M14 34 L14 26 L96 26 L100 14 L188 14 C192 28 196 48 202 60 C206 76 210 96 214 108 C214 120 210 136 206 150 C203 166 200 184 198 200 C196 208 195 214 190 222 C186 228 180 232 168 238 C156 243 142 248 132 250 C129 247 138 244 150 240 C160 236 168 232 176 226 C174 224 170 222 164 218 C158 212 154 206 150 198 C146 190 142 180 138 168 C134 156 130 144 128 134 C124 130 122 124 126 118 C122 108 116 94 110 82 C106 74 102 68 98 62 C92 58 84 58 76 62 C66 60 56 58 46 54 C36 50 26 44 14 34 Z"
    />
    <g>
      {
        regions.map((r) => (
          <>
            <circle class="fl-ring" cx={r.ring.x} cy={r.ring.y} r={r.ring.r} />
            {r.dots.map((d) => (
              <circle class="fl-dot" cx={d.x} cy={d.y} r={r.dots.length > 1 ? 3.2 : 4} />
            ))}
            <text class="fl-label" x={r.label.x} y={r.label.y}>{r.name}</text>
            <text class="fl-sub" x={r.label.x} y={r.label.y + 9}>{r.mapSub}</text>
          </>
        ))
      }
    </g>
  </svg>
</div>
